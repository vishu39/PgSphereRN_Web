# Auto-detect text files and normalize line endings to LF
* text=auto

# Code files
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.svg text eol=lf

# Binary files
*.apk binary
*.png binary
*.jpg binary
*.ico binary

